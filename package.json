{
  "name": "@ilanlal/gas-addon-ai-template",
  "version": "1.1.0",
  "description": "A Google Sheets add-on to enhance AI capabilities within Google Sheets, providing various plugins and features to assist users in leveraging AI technologies directly from their spreadsheets.",
  "main": "./src/index.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "webpack --mode development",
    "start": "webpack-dev-server --mode development",
    "publish": "npm publish --access public --tag latest --registry https://npm.pkg.github.com",
    "prepublishOnly": "npm version patch && npm run test && npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilanlal/gas-addon-ai-template.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "addon",
    "spreadsheet",
    "google apps script",
    "gemini api",
    "generative ai",
    "google sheets",
    "productivity",
    "ai",
    "artificial intelligence",
    "machine learning",
    "natural language processing",
    "data analysis"
  ],
  "author": "Ilan Laloum <ilanlal@gmail.com> (https://github.com/ilanlal)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ilanlal/gas-addon-ai-template/issues"
  },
  "homepage": "https://github.com/ilanlal/gas-addon-ai-template#readme",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@eslint/js": "^10.0.1",
    "@ilanlal/gasmocks": "github:ilanlal/gasmocks",
    "@types/google-apps-script": "^2.0.8",
    "@types/jest": "^30.0.0",
    "babel-loader": "^10.0.0",
    "baseline-browser-mapping": "^2.9.6",
    "eslint": "^10.0.3",
    "globals": "^15.15.0",
    "jest": "^30.3.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "glob": "^10.4.0"
  },
  "jest": {
    "modulePaths": [
      "<rootDir>/src/"
    ],
    "coverageDirectory": "./coverage/",
    "collectCoverage": false,
    "testEnvironment": "node"
  },
  "files": [
    "./dist/app.js",
    "README.md",
    "LICENSE"
  ]
}